<%- include('partials/header') -%>


    <form>
        <h1> Create Hotel </h1>
        <label for="name">Name</label>
        <input type="text" name="name" required>

        <label for="location">Location</label>
        <input type="text" name="location" required>

        <label for="image">Image</label>
        <input type="text" name="image" required>

        <label for="rating">Rating</label>
        <input type="text" name="rating" required>

        <label for="governorate">Governorate</label>
        <input type="text" name="governorate" required>

        <label for="description">Description</label>
        <input type="text" name="description" required>

        <button >Create</button>

    </form>

    <script>
        const form = document.querySelector('form')

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            //Get values
            const name = form.name.value;
            const location = form.location.value;
            const image = form.image.value;
            const rating = form.rating.value;
            const governorate = form.governorate.value;
            const description = form.description.value;

            try
            {
                const res = await fetch('/hotel/add', {
                    method: 'POST',
                    body: JSON.stringify({name, location, image, rating, governorate, description }),
                    headers: { 'Content-Type': 'application/json' }
                });
                console.log("Successfully added a new hotel")
            }
            catch (err)
            {
                console.log(err)
            }
        })
    </script>

<%- include('partials/footer') -%>